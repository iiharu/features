{
    "name": "Antigravity",
    "id": "antigravity",
    "version": "0.0.7",
    "description": "A antigravity world feature",
    "options": {},
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "mounts": [
        {
            "source": "${localEnv:HOME}/.gitconfig",
            "target": "/var/tmp/.gitconfig",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.gemini",
            "target": "/var/tmp/.gemini",
            "type": "bind"
        }
    ]
}
