{
    "name": "Antigravity",
    "id": "antigravity",
    "version": "0.0.9",
    "description": "My antigravity devcontainer feature",
    "options": {},
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "mounts": [
        {
            "source": "${localEnv:HOME}/.gitconfig",
            "target": "/var/tmp/.gitconfig",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.gemini",
            "target": "/var/tmp/.gemini",
            "type": "bind"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "Google.gemini-cli-vscode-ide-companion"
            ]
        }
    }
}
