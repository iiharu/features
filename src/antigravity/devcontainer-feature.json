{
    "name": "Antigravity",
    "id": "antigravity",
    "version": "0.0.5",
    "description": "A antigravity world feature",
    "options": {},
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "mounts": [
        // NOTE: `docker --mount` is not compatible with `${remoteEnv:HOME}` or `${containerEnv:HOME}`
        {
            "source": "${localEnv:HOME}/.gitconfig",
            "target": "/home/vscode/.gitconfig",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.gemini",
            "target": "/home/vscode/.gemini",
            "type": "bind"
        }
    ]
}
