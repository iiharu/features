{
    "name": "Codex",
    "id": "codex",
    "version": "0.0.4",
    "description": "Install OpenAI Codex CLI",
    "options": {},
    "containerEnv": {
        "CODEX_HOME": "/home/vscode/.codex"
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "mounts": [
        {
            "source": "codex-home-${devcontainerId}",
            "target": "/home/vscode/.codex",
            "type": "volume"
        },
        {
            "source": "/etc/codex/config.toml",
            "target": "/etc/codex/config.toml",
            "type": "bind"
        }
    ],
    "postCreateCommand": "installer=$(curl -fsSL https://chatgpt.com/codex/install.sh) && CODEX_NON_INTERACTIVE=1 sh -c \"$installer\""
}
