{
    "name": "Codex",
    "id": "codex",
    "version": "0.0.3",
    "description": "Install OpenAI Codex CLI",
    "options": {},
    "containerEnv": {
        "CODEX_HOME": "/var/tmp/codex"
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "mounts": [
        {
            "source": "codex-home-${devcontainerId}",
            "target": "/var/tmp/codex",
            "type": "volume"
        },
        {
            "source": "/etc/codex/config.toml",
            "target": "/etc/codex/config.toml",
            "type": "bind"
        }
    ]
}
